{
  "openapi": "3.0.3",
  "info": {
    "title": "Box office API",
    "version": "1.0.0",
    "description": "Events, orders paid through Stripe, tickets and check-in at the door."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "Says the API is up",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/organisers": {
      "get": {
        "operationId": "listOrganisers",
        "summary": "The organisers an event can be created for",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "listUpcomingEvents",
        "summary": "The events on sale that are still to come",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "Create an event, as a draft",
        "responses": {
          "201": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEvent"
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "get": {
        "operationId": "getEvent",
        "summary": "One event with its ticket types",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/events/{id}/ticket-types": {
      "post": {
        "operationId": "addTicketType",
        "summary": "Add a kind of ticket to a draft",
        "responses": {
          "201": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTicketType"
              }
            }
          }
        }
      }
    },
    "/api/events/{id}/publish": {
      "post": {
        "operationId": "publishEvent",
        "summary": "Put an event on sale",
        "responses": {
          "201": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/orders": {
      "post": {
        "operationId": "holdSeats",
        "summary": "Hold seats and get the Stripe checkout page",
        "responses": {
          "201": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewOrder"
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "An order and its tickets",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/orders/{id}/refund": {
      "post": {
        "operationId": "refundOrder",
        "summary": "Give a paid order back, before its event starts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "OK"
          }
        }
      }
    },
    "/api/check-ins": {
      "post": {
        "operationId": "scanTicket",
        "summary": "Check a ticket in at the door",
        "responses": {
          "201": {
            "description": "OK"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scan"
              }
            }
          }
        }
      }
    },
    "/api/payments/webhook": {
      "post": {
        "operationId": "stripeWebhook",
        "summary": "Stripe says a checkout was paid",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewEvent": {
        "type": "object",
        "required": [
          "organiserId",
          "title",
          "venue",
          "startsAt"
        ],
        "properties": {
          "organiserId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NewTicketType": {
        "type": "object",
        "required": [
          "name",
          "priceCents",
          "capacity"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "NewOrder": {
        "type": "object",
        "required": [
          "ticketTypeId",
          "quantity",
          "buyerName",
          "buyerEmail"
        ],
        "properties": {
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "buyerName": {
            "type": "string"
          },
          "buyerEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Scan": {
        "type": "object",
        "required": [
          "eventId",
          "code"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
